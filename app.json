{
  "expo": {
    "name": "HTP Fitness",
    "slug": "htp-fitness",
    "scheme": "htp-fitness",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/239c2585-a100-4712-aa9b-ecc2199f0d5c"
    },
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.htp.fitness",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "buildNumber": "3"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0D0D0D"
      },
      "package": "com.htp.fitness",
      "permissions": [
        "android.permission.health.READ_STEPS"
      ]
    },
    "plugins": [
      "expo-asset",
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "expo-secure-store",
      "expo-notifications",
      [
        "react-native-health",
        {
          "healthSharePermission": "HTP Fitness reads your step count to show your activity."
        }
      ],
      "expo-health-connect",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "239c2585-a100-4712-aa9b-ecc2199f0d5c"
      }
    },
    "owner": "coach.hockt"
  }
}
