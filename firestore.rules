rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: the requesting user's own /users doc data
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Helper: check if the requesting user is the admin
    function isAdmin() {
      return request.auth != null && userData().role == 'admin';
    }

    // Helper: check if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: account is approved and not deactivated. New signups start in
    // 'pending' (no access until the trainer approves them); 'inactive' is a
    // deactivated account. Legacy docs without category/status default to
    // active (matches getCategory() in AdminScreen).
    function isActive() {
      return request.auth != null
        && userData().get('category', 'inPerson') != 'inactive'
        && userData().get('category', 'inPerson') != 'pending'
        && userData().get('status', 'active') != 'closed';
    }

    // ─── USERS COLLECTION ───
    match /users/{userId} {
      // Users can read their own doc
      // Admin can read all user docs (for AdminScreen)
      allow read: if isSignedIn()
        && (request.auth.uid == userId || isAdmin());

      // Users can create their own doc on registration
      // Role must be 'user' unless the token email matches the admin email
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && (
          request.resource.data.role == 'user'
          || (request.resource.data.role == 'admin'
              && request.auth.token.email == 'coach.hockt@gmail.com')
        );

      // Users can update their own doc (profile, body metrics)
      // But cannot change their own role, email, status, category, or isNew.
      // category gates login (inactive = blocked), so only admin may change it.
      // Admin can update any user doc (move between active/online/inactive).
      allow update: if isSignedIn()
        && (
          (request.auth.uid == userId
            && isActive()
            && request.resource.data.role == resource.data.role
            && request.resource.data.email == resource.data.email
            && request.resource.data.status == resource.data.status
            && request.resource.data.get('category', null) == resource.data.get('category', null)
            && request.resource.data.get('isNew', null) == resource.data.get('isNew', null))
          || isAdmin()
        );

      // No one can delete user docs from client
      allow delete: if false;
    }

    // ─── CLIENTS COLLECTION ───
    match /clients/{clientId} {
      // Trainers can only read clients they own
      // Admin can read any client
      allow read: if isSignedIn()
        && (resource.data.trainerId == request.auth.uid || isAdmin());

      // Trainers can create clients assigned to themselves
      allow create: if isSignedIn()
        && request.resource.data.trainerId == request.auth.uid;

      // Trainers can update/delete only their own clients
      // Admin can update/delete any client
      allow update, delete: if isSignedIn()
        && (resource.data.trainerId == request.auth.uid || isAdmin());
    }

    // ─── SESSIONS COLLECTION ───
    match /sessions/{sessionId} {
      // Trainers can read sessions they created OR sessions where they are the client
      // Admin can read any session
      allow read: if isSignedIn()
        && isActive()
        && (resource.data.trainerId == request.auth.uid
            || resource.data.clientId == request.auth.uid
            || isAdmin());

      // Trainers can create sessions assigned to themselves
      allow create: if isSignedIn()
        && request.resource.data.trainerId == request.auth.uid
        && isActive();

      // Trainers can update/delete sessions they created
      // Users can delete their own sessions (clientId == uid)
      // Admin can update/delete any session
      allow update, delete: if isSignedIn()
        && isActive()
        && (resource.data.trainerId == request.auth.uid
            || resource.data.clientId == request.auth.uid
            || isAdmin());
    }

    // ─── SCHEDULES COLLECTION ───
    match /schedules/{userId} {
      allow read, create, update: if isSignedIn()
        && request.auth.uid == userId
        && isActive();
      allow delete: if false;
    }

    // ─── SAVED WORKOUTS COLLECTION ───
    match /savedWorkouts/{docId} {
      // Users can read their own saved workouts; admin can read any
      allow read: if isSignedIn()
        && isActive()
        && (resource.data.clientId == request.auth.uid || isAdmin());

      // Users can bookmark only for themselves (clientId == own uid).
      // Admin can assign workouts to any client (clientId == client doc id).
      allow create: if isSignedIn()
        && isActive()
        && (request.resource.data.clientId == request.auth.uid || isAdmin());

      // Owner or admin can update/delete
      allow update, delete: if isSignedIn()
        && isActive()
        && (resource.data.clientId == request.auth.uid || isAdmin());
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
